{
  "name": "workspace-tasks-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:full": "concurrently -k -n api,web \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
